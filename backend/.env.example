# ── Banco de Dados (Supabase) ─────────────────────────────────
# Copie a connection string do painel do Supabase
# Settings > Database > Connection string > URI
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@db.[SEU-ID].supabase.co:5432/postgres?sslmode=require"

# ── JWT ───────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cole-aqui-uma-string-longa-e-aleatoria"
JWT_EXPIRES_IN="8h"

REFRESH_TOKEN_SECRET="cole-aqui-outro-secret-diferente"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ── CORS ──────────────────────────────────────────────────────
# URL do seu frontend (Vercel)
FRONTEND_URL="https://caixa.centraltech.com"

# ── Ambiente ──────────────────────────────────────────────────
NODE_ENV="production"
PORT=3000
